                                                          "restore_light_data": "{% set light = namespace(data={}) %} {% set light.data = dict(light.data, **{ 'color_temp_kelvin': dynamic_kelvin }) %} {% set light.data = dict(light.data, **{ 'brightness_pct': restore_bri }) %} {% if 'use_transition' in include_light_control %}\n  {% set light.data = dict(light.data, **{ 'transition': light_transition_on }) %}\n{% endif %} {{ light.data }}"
                                                        }
                                                      },
                                                      {
                                                        "action": "light.turn_on",
                                                        "target": {
                                                          "entity_id": "{{ repeat.item }}"
                                                        },
                                                        "data": "{{ restore_light_data }}"
                                                      }
                                                    ]
                                                  }
