                                    "conditions": [
                                      {
                                        "condition": "template",
                                        "value_template": "{% if boolean_scenes_scripts == [] %}\n  false\n{% elif is_state(boolean_scenes_scripts, 'on') %}\n  true\n{% else %}\n  false\n{% endif %}"
                                      }
                                    ],
                                    "sequence": [
                                      {
                                        "alias": "Turn off the boolean for scenes and scripts",
                                        "action": "input_boolean.turn_off",
                                        "data": {
