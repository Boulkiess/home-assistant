                                                    "state": "on"
                                                  },
                                                  {
                                                    "condition": "state",
                                                    "entity_id": [],
                                                    "match": "any",
                                                    "state": "on"
                                                  },
                                                  {
                                                    "condition": "state",
                                                    "entity_id": [],
                                                    "match": "any",
