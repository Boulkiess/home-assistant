                                            "condition": "state",
                                            "entity_id": [],
                                            "state": "off"
                                          },
                                          {
                                            "condition": "state",
                                            "entity_id": [],
                                            "state": "off"
                                          },
                                          {
                                            "condition": "state",
                                            "entity_id": [],
                                            "state": "off"
                                          }
                                        ]
                                      },
                                      {
                                        "condition": "and",
                                        "conditions": [
                                          "{{ ('bypass_enabled_turn_on' in include_bypass) and ('bypass_enabled_turn_off' in include_bypass) and ('bypass_enabled_stop' not in include_bypass) }}",
                                          {
                                            "condition": "state",
                                            "entity_id": [],
                                            "state": "off"
                                          },
                                          {
                                            "condition": "state",
                                            "entity_id": [],
                                            "state": "off"
