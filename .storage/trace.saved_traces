                      {
                        "alias": "By-pass is turned on & check by-pass option - Keep the current lights state",
                        "conditions": [
                          {
                            "condition": "trigger",
                            "id": "t7_stop"
                          }
                        ],
                        "sequence": [
                          {
                            "choose": [
                              {
                                "alias": "If dim before OFF is selected - Restore Lights before pausing",
                                "conditions": [
                                  {
                                    "condition": "template",
                                    "value_template": "{{ include_dim_before_off == 'dim_before_off_enabled' }}"
                                  },
                                  {
                                    "condition": "state",
                                    "entity_id": [],
                                    "state": "on"
                                  }
                                ],
                                "sequence": [
                                  {
                                    "repeat": {
                                      "for_each": "{{ light_entities }}",
                                      "sequence": [
                                        {
                                          "variables": {
