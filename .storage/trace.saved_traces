                                                }
                                              ],
                                              "sequence": [
                                                {
                                                  "action": "light.turn_on",
                                                  "target": {
                                                    "entity_id": "{{ light_entities }}"
                                                  },
                                                  "data": "{{ dynamic_light_data }}"
                                                },
                                                {
                                                  "alias": "Wait for sun elevation to change",
                                                  "wait_for_trigger": [
                                                    {
                                                      "trigger": "state",
                                                      "entity_id": "sun.sun",
