                    ]
                  },
                  {
                    "condition": "trigger",
                    "id": [
                      "t7_on",
                      "t7_off",
                      "t7_stop",
                      "t8_on",
                      "t8_off",
                      "t8_stop",
                      "t18"
                    ]
                  }
                ]
              },
              {
                "condition": "or",
                "conditions": [
                  "{{ include_device_tracker == 'device_tracker_disabled' }}",
                  {
                    "condition": "and",
