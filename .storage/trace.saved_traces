                                                "condition": "state",
                                                "entity_id": [],
                                                "match": "any",
                                                "state": "on"
                                              },
                                              {
                                                "condition": "state",
                                                "entity_id": [],
                                                "match": "any",
                                                "state": "on"
                                              }
                                            ]
                                          }
                                        ]
                                      },
                                      {
                                        "condition": "and",
                                        "conditions": [
                                          "{{ ('bypass_enabled_turn_on' in include_bypass) and ('bypass_enabled_turn_off' in include_bypass) and ('bypass_enabled_stop' not in include_bypass) }}",
                                          {
                                            "condition": "or",
                                            "conditions": [
                                              {
                                                "condition": "state",
                                                "entity_id": [],
                                                "match": "any",
                                                "state": "on"
                                              },
                                              {
                                                "condition": "state",
                                                "entity_id": [],
                                                "match": "any",
                                                "state": "on"
                                              }
                                            ]
