                                                "condition": "template",
                                                "value_template": "{% set opposite = 'off' if state_control_activation_state == 'on' else 'on' %} {{ is_state(state_control_entity, opposite) }}"
                                              }
                                            ]
                                          }
                                        ]
                                      }
                                    ],
