                                                "value_template": "{{ night_light_include_dim_before_off == 'dim_before_off_enabled' }}"
                                              }
                                            ],
                                            "sequence": [
                                              {
                                                "repeat": {
                                                  "for_each": "{{ night_light_entities }}",
                                                  "sequence": [
                                                    {
                                                      "action": "light.turn_on",
                                                      "target": {
                                                        "entity_id": "{{ repeat.item }}"
                                                      },
                                                      "data": {
                                                        "brightness_pct": "{% set bri = state_attr(repeat.item, 'brightness') %} {% if bri in [None, 0] %}\n  {{ 0 }}\n{% else %}\n  {% set bri_pct = (bri / 255 * 100) %}\n  {% set dimmed = bri_pct * night_light_dim_before_off_factor %}\n  {{ [dimmed | round(0), 1] | max }}\n{% endif %}\n"
                                                      }
                                                    }
                                                  ]
                                                }
                                              },
                                              {
                                                "action": "input_boolean.turn_on",
                                                "target": {
                                                  "entity_id": []
                                                }
                                              },
                                              {
                                                "alias": "Wait the number of minutes set in the dim before OFF time delay",
                                                "delay": {
                                                  "seconds": 30
                                                }
                                              },
                                              {
                                                "action": "input_boolean.turn_off",
                                                "target": {
                                                  "entity_id": []
                                                }
                                              }
                                            ]
                                          }
                                        ]
                                      },
