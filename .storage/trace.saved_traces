                            ]
                          },
                          {
                            "alias": "By-pass is turned on & check by-pass option - Keep the current lights state",
                            "conditions": [
                              {
                                "condition": "trigger",
                                "id": "t7_stop"
                              }
                            ],
                            "sequence": [
                              {
                                "choose": [
                                  {
                                    "alias": "If dim before OFF is selected - Restore Lights before pausing",
                                    "conditions": [
                                      {
                                        "condition": "template",
                                        "value_template": "{{ night_light_include_dim_before_off == 'dim_before_off_enabled' }}"
                                      },
                                      {
                                        "condition": "state",
                                        "entity_id": [],
                                        "state": "on"
                                      }
                                    ],
                                    "sequence": [
                                      {
                                        "repeat": {
                                          "for_each": "{{ night_light_entities }}",
                                          "sequence": [
                                            {
                                              "variables": {
                                                "restore_bri": "{% set bri = state_attr(repeat.item, 'brightness') %} {% if bri in [None, 0] %}\n  {{ 0 }}\n{% else %}\n  {% set bri_pct = bri / 255 * 100 %}\n  {% set restored = (bri_pct / night_light_dim_before_off_factor) %}\n  {{ [restored | round(0), 100] | min }}\n{% endif %}\n",
                                                "restore_light_data": "{% set light = namespace(data={}) %} {% if 'use_transition' in include_night_light_control %}\n  {% set light.data = dict(light.data, **{ 'transition': night_light_transition_on }) %}\n{% endif %} {% set light.data = dict(light.data, **{ 'brightness_pct': restore_bri }) %} {{ light.data }}"
                                              }
                                            },
                                            {
                                              "action": "light.turn_on",
                                              "target": {
                                                "entity_id": "{{ repeat.item }}"
                                              },
                                              "data": "{{ restore_light_data }}"
                                            }
                                          ]
                                        }
                                      },
                                      {
                                        "action": "input_boolean.turn_off",
                                        "target": {
                                          "entity_id": []
                                        }
                                      }
                                    ]
                                  }
                                ]
                              },
                              {
                                "alias": "Check by-pass settings and preform the correct action",
                                "if": [
                                  {
                                    "condition": "or",
                                    "conditions": [
                                      {
                                        "condition": "and",
                                        "conditions": [
                                          {
                                            "alias": "Check if the by-pass auto off is enabled",
                                            "condition": "template",
                                            "value_template": "{{ 'bypass_auto_off_enabled_on' in include_bypass_auto_off }}"
                                          },
                                          {
                                            "condition": "state",
                                            "entity_id": [],
                                            "match": "any",
                                            "state": "on"
                                          }
                                        ]
                                      },
                                      {
                                        "condition": "and",
                                        "conditions": [
                                          {
                                            "alias": "Check if the by-pass auto off is enabled",
                                            "condition": "template",
                                            "value_template": "{{ 'bypass_auto_off_enabled_off' in include_bypass_auto_off }}"
                                          },
                                          {
                                            "condition": "state",
                                            "entity_id": [],
                                            "match": "any",
                                            "state": "on"
                                          }
                                        ]
                                      },
                                      {
                                        "condition": "and",
                                        "conditions": [
                                          {
                                            "alias": "Check if the by-pass auto off is enabled",
                                            "condition": "template",
                                            "value_template": "{{ 'bypass_auto_off_enabled_stop' in include_bypass_auto_off }}"
                                          },
                                          {
                                            "condition": "state",
                                            "entity_id": [],
                                            "match": "any",
                                            "state": "on"
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                ],
                                "then": [
                                  {
                                    "alias": "Wait the number of minutes set in the by-pass auto off time delay",
                                    "delay": {
                                      "minutes": 60
                                    }
                                  },
                                  {
                                    "alias": "Parallel Actions for the by-pass auto off",
                                    "parallel": [
                                      {
                                        "sequence": [
                                          {
                                            "choose": [
                                              {
                                                "conditions": [
                                                  {
                                                    "condition": "template",
                                                    "value_template": "{{ ('bypass_enabled_turn_on' in include_bypass) and ('bypass_auto_off_enabled_on' in include_bypass_auto_off) }}"
                                                  }
                                                ],
                                                "sequence": [
                                                  {
                                                    "alias": "Turn off the by-pass",
                                                    "action": "homeassistant.turn_off",
                                                    "entity_id": []
                                                  }
                                                ]
                                              }
                                            ]
                                          }
                                        ]
                                      },
                                      {
                                        "sequence": [
                                          {
                                            "choose": [
                                              {
                                                "conditions": [
                                                  {
                                                    "condition": "template",
                                                    "value_template": "{{ ('bypass_enabled_turn_off' in include_bypass) and ('bypass_auto_off_enabled_off' in include_bypass_auto_off) }}"
                                                  }
                                                ],
                                                "sequence": [
                                                  {
                                                    "alias": "Turn off the by-pass",
                                                    "action": "homeassistant.turn_off",
                                                    "entity_id": []
                                                  }
                                                ]
                                              }
                                            ]
                                          }
                                        ]
                                      },
