                                                      "conditions": "{{ expand(light_entities) | selectattr('state', '==', 'off') | list | count > 0 }}",
                                                      "sequence": [
                                                        {
                                                          "alias": "Delay for parallel actions needed for when the light is off",
                                                          "delay": {
                                                            "milliseconds": 100
                                                          }
                                                        }
                                                      ]
                                                    }
                                                  ]
