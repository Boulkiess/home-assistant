                                "alias": "13 - Dynamic Lighting - Time Controlled - Colour Temp & Brightness",
                                "conditions": [
                                  {
                                    "condition": "template",
                                    "value_template": "{{ include_dynamic_lighting == 'enable_time_controled_colour_brightness' }}"
