                                        "condition": "state",
                                        "entity_id": [],
                                        "match": "any",
                                        "state": "on"
                                      }
                                    ]
                                  },
                                  {
                                    "condition": "and",
                                    "conditions": [
                                      {
                                        "alias": "Check if the by-pass auto off is enabled",
                                        "condition": "template",
                                        "value_template": "{{ 'bypass_auto_off_enabled_off' in include_bypass_auto_off }}"
                                      },
                                      {
                                        "condition": "state",
                                        "entity_id": [],
                                        "match": "any",
                                        "state": "on"
                                      }
                                    ]
                                  },
                                  {
                                    "condition": "and",
                                    "conditions": [
                                      {
                                        "alias": "Check if the by-pass auto off is enabled",
                                        "condition": "template",
                                        "value_template": "{{ 'bypass_auto_off_enabled_stop' in include_bypass_auto_off }}"
                                      },
                                      {
                                        "condition": "state",
                                        "entity_id": [],
                                        "match": "any",
                                        "state": "on"
                                      }
                                    ]
                                  }
                                ]
                              }
